<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The HomeApps kit comes from the local feed that HomeApps' scripts/pack.sh fills (docs/plugins.md in HomeApps). -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="homeapps" value="%HOME%/.homeapps/packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="homeapps">
      <package pattern="HomeApps.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
